# API、前台、后台的地址
PUBLIC_URL=http://localhost:3900
BLOG_URL=http://localhost:5173
ADMIN_URL=http://localhost:5174

DATABASE_URL=postgres://postgres@localhost:5432/driftlog
REDIS_URL=redis://localhost:6379
MEILI_URL=http://localhost:7700
MEILI_KEY=

DATA_DIR=./data
# local | s3（s3 时填 S3_ACCESS_KEY_ID / S3_SECRET_ACCESS_KEY / S3_BUCKET / S3_ENDPOINT / S3_PUBLIC_URL）
STORAGE=local

# 生产环境必填：openssl rand -base64 32
BETTER_AUTH_SECRET=
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# 可选，填了才开
AI_MODEL=
AI_GATEWAY_API_KEY=
RESEND_API_KEY=
MAIL_FROM=Driftlog <noreply@example.com>
SENTRY_DSN=
